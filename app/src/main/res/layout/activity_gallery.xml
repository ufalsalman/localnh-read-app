<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/galleryRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <ImageView android:id="@+id/galleryCover" android:layout_width="match_parent" android:layout_height="420dp" android:contentDescription="@null" android:scaleType="fitCenter" />
        <TextView android:id="@+id/galleryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/galleryId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_primary" android:textSize="14sp" />
        <LinearLayout android:id="@+id/galleryTags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
        <LinearLayout android:id="@+id/galleryDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <Button android:id="@+id/readButton" style="@style/Widget.LocalNHRead.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/read" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/previewGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:nestedScrollingEnabled="false" />
    </LinearLayout>
</ScrollView>
