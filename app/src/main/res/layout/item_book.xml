<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" android:clickable="true" android:focusable="true" android:orientation="vertical">
    <id.ufal.localnhread.CoverImageView android:id="@+id/bookCover" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface_variant" android:contentDescription="@null" android:scaleType="centerCrop" />
    <TextView android:id="@+id/bookTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="8dp" android:ellipsize="end" android:gravity="center" android:maxLines="3" android:textColor="@color/text_primary" android:textSize="14sp" />
</LinearLayout>
