<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="14dp" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/rescanButton" style="@style/Widget.LocalNHRead.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rescan" />
        <Button android:id="@+id/changeFolderButton" style="@style/Widget.LocalNHRead.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/change_folder" />
    </LinearLayout>
    <TextView android:id="@+id/folderLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="12dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/bookList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="5dp" android:paddingBottom="12dp" />
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="32dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_title" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/empty_body" android:textColor="@color/text_secondary" android:textSize="15sp" />
            <Button android:id="@+id/chooseFolderButton" style="@style/Widget.LocalNHRead.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/choose_folder" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
